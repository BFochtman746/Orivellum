{
  "$description": "Orivellum design tokens — single source of truth (WP2). DTCG-style: raw palette → semantic roles (per-mode via $extensions['orivellum.modes']) → component accents. src/styles/gd-tokens.css must mirror these values exactly; tests/test_design_tokens.py enforces parity and the contrast contract below.",
  "raw": {
    "white":        { "$type": "color", "$value": "#FFFFFF" },
    "bone-100":     { "$type": "color", "$value": "#FBFAF6" },
    "bone-200":     { "$type": "color", "$value": "#F4F1E9" },
    "bone-300":     { "$type": "color", "$value": "#EAE6DC" },
    "bone-400":     { "$type": "color", "$value": "#D8D2C5" },
    "taupe-500":    { "$type": "color", "$value": "#8E8678" },
    "ink-900":      { "$type": "color", "$value": "#172532" },
    "ink-600":      { "$type": "color", "$value": "#465765" },
    "ink-500":      { "$type": "color", "$value": "#5D6A74" },
    "navy-700":     { "$type": "color", "$value": "#173B57" },
    "olive-600":    { "$type": "color", "$value": "#5D6839" },
    "brass-600":    { "$type": "color", "$value": "#865B19" },
    "teal-600":     { "$type": "color", "$value": "#006F6B" },
    "slate-600":    { "$type": "color", "$value": "#3C6281" },
    "red-600":      { "$type": "color", "$value": "#A33A2F" },
    "ochre-600":    { "$type": "color", "$value": "#8A6412" },
    "green-600":    { "$type": "color", "$value": "#1F7A44" },
    "violet-500":   { "$type": "color", "$value": "#6D4FD8" },
    "gunmetal-950": { "$type": "color", "$value": "#101418" },
    "gunmetal-900": { "$type": "color", "$value": "#14181D" },
    "gunmetal-800": { "$type": "color", "$value": "#1B2026" },
    "gunmetal-700": { "$type": "color", "$value": "#232930" },
    "gunmetal-650": { "$type": "color", "$value": "#2B323A" },
    "gunmetal-600": { "$type": "color", "$value": "#39424C" },
    "gunmetal-500": { "$type": "color", "$value": "#485460" },
    "gunmetal-400": { "$type": "color", "$value": "#707D8A" },
    "gunmetal-300": { "$type": "color", "$value": "#76838F" },
    "steel-300":    { "$type": "color", "$value": "#A6B1BC" },
    "parchment-100":{ "$type": "color", "$value": "#EAE7E0" },
    "slate-400":    { "$type": "color", "$value": "#7C9BC0" },
    "olive-300":    { "$type": "color", "$value": "#A8B36B" },
    "brass-300":    { "$type": "color", "$value": "#C9964B" },
    "teal-300":     { "$type": "color", "$value": "#3FC9B8" },
    "red-400":      { "$type": "color", "$value": "#E5604A" },
    "gold-400":     { "$type": "color", "$value": "#E0A93E" },
    "green-400":    { "$type": "color", "$value": "#5FBF7E" },
    "violet-300":   { "$type": "color", "$value": "#A78BFA" },
    "black-brass":  { "$type": "color", "$value": "#171004" },
    "black-olive":  { "$type": "color", "$value": "#101206" },
    "black-teal":   { "$type": "color", "$value": "#04120F" },
    "black-slate":  { "$type": "color", "$value": "#0A1017" }
  },
  "semantic": {
    "canvas":          { "$type": "color", "$value": "{raw.bone-200}",     "$extensions": { "orivellum.modes": { "daylight": "{raw.bone-200}",     "hull": "{raw.gunmetal-900}" } } },
    "surface":         { "$type": "color", "$value": "{raw.bone-100}",     "$extensions": { "orivellum.modes": { "daylight": "{raw.bone-100}",     "hull": "{raw.gunmetal-800}" } } },
    "raised":          { "$type": "color", "$value": "{raw.white}",        "$extensions": { "orivellum.modes": { "daylight": "{raw.white}",        "hull": "{raw.gunmetal-700}" } } },
    "recessed":        { "$type": "color", "$value": "{raw.bone-300}",     "$extensions": { "orivellum.modes": { "daylight": "{raw.bone-300}",     "hull": "{raw.gunmetal-950}" } } },
    "card-press":      { "$type": "color", "$value": "{raw.bone-200}",     "$extensions": { "orivellum.modes": { "daylight": "{raw.bone-200}",     "hull": "{raw.gunmetal-650}" } } },
    "line-decorative": { "$type": "color", "$value": "{raw.bone-400}",     "$extensions": { "orivellum.modes": { "daylight": "{raw.bone-400}",     "hull": "{raw.gunmetal-600}" } } },
    "line-control":    { "$type": "color", "$value": "{raw.taupe-500}",    "$extensions": { "orivellum.modes": { "daylight": "{raw.taupe-500}",    "hull": "{raw.gunmetal-400}" } } },
    "line-2":          { "$type": "color", "$value": "{raw.taupe-500}",    "$extensions": { "orivellum.modes": { "daylight": "{raw.taupe-500}",    "hull": "{raw.gunmetal-500}" } } },
    "text":            { "$type": "color", "$value": "{raw.ink-900}",      "$extensions": { "orivellum.modes": { "daylight": "{raw.ink-900}",      "hull": "{raw.parchment-100}" } } },
    "text-muted":      { "$type": "color", "$value": "{raw.ink-600}",      "$extensions": { "orivellum.modes": { "daylight": "{raw.ink-600}",      "hull": "{raw.steel-300}" } } },
    "text-subtle":     { "$type": "color", "$value": "{raw.ink-500}",      "$extensions": { "orivellum.modes": { "daylight": "{raw.ink-500}",      "hull": "{raw.gunmetal-300}" } } },
    "primary":         { "$type": "color", "$value": "{raw.navy-700}",     "$extensions": { "orivellum.modes": { "daylight": "{raw.navy-700}",     "hull": "{raw.slate-400}" } } },
    "focus":           { "$type": "color", "$value": "{raw.navy-700}",     "$extensions": { "orivellum.modes": { "daylight": "{raw.navy-700}",     "hull": "{raw.slate-400}" } } },
    "olive":           { "$type": "color", "$value": "{raw.olive-600}",    "$extensions": { "orivellum.modes": { "daylight": "{raw.olive-600}",    "hull": "{raw.olive-300}" } } },
    "bronze":          { "$type": "color", "$value": "{raw.brass-600}",    "$extensions": { "orivellum.modes": { "daylight": "{raw.brass-600}",    "hull": "{raw.brass-300}" } } },
    "sonar":           { "$type": "color", "$value": "{raw.teal-600}",     "$extensions": { "orivellum.modes": { "daylight": "{raw.teal-600}",     "hull": "{raw.teal-300}" } } },
    "slate":           { "$type": "color", "$value": "{raw.slate-600}",    "$extensions": { "orivellum.modes": { "daylight": "{raw.slate-600}",    "hull": "{raw.slate-400}" } } },
    "danger":          { "$type": "color", "$value": "{raw.red-600}",      "$extensions": { "orivellum.modes": { "daylight": "{raw.red-600}",      "hull": "{raw.red-400}" } } },
    "caution":         { "$type": "color", "$value": "{raw.ochre-600}",    "$extensions": { "orivellum.modes": { "daylight": "{raw.ochre-600}",    "hull": "{raw.gold-400}" } } },
    "success":         { "$type": "color", "$value": "{raw.green-600}",    "$extensions": { "orivellum.modes": { "daylight": "{raw.green-600}",    "hull": "{raw.green-400}" } } },
    "info":            { "$type": "color", "$value": "{raw.slate-600}",    "$extensions": { "orivellum.modes": { "daylight": "{raw.slate-600}",    "hull": "{raw.slate-400}" } } },
    "violet":          { "$type": "color", "$value": "{raw.violet-500}",   "$extensions": { "orivellum.modes": { "daylight": "{raw.violet-500}",   "hull": "{raw.violet-300}" } } },
    "accent-default":  { "$type": "color", "$value": "{raw.navy-700}",     "$extensions": { "orivellum.modes": { "daylight": "{raw.navy-700}",     "hull": "{raw.teal-300}" } } },
    "accent-ink":      { "$type": "color", "$value": "{raw.white}",        "$extensions": { "orivellum.modes": { "daylight": "{raw.white}",        "hull": "{raw.gunmetal-900}" } } }
  },
  "component": {
    "accent": {
      "writing":  { "$type": "color", "$extensions": { "orivellum.modes": { "daylight": "{raw.brass-600}", "hull": "{raw.brass-300}" } } },
      "learning": { "$type": "color", "$extensions": { "orivellum.modes": { "daylight": "{raw.olive-600}", "hull": "{raw.olive-300}" } } },
      "library":  { "$type": "color", "$extensions": { "orivellum.modes": { "daylight": "{raw.olive-600}", "hull": "{raw.olive-300}" } } },
      "chat":     { "$type": "color", "$extensions": { "orivellum.modes": { "daylight": "{raw.teal-600}",  "hull": "{raw.teal-300}" } } },
      "studio":   { "$type": "color", "$extensions": { "orivellum.modes": { "daylight": "{raw.slate-600}", "hull": "{raw.slate-400}" } } },
      "mail":     { "$type": "color", "$extensions": { "orivellum.modes": { "daylight": "{raw.slate-600}", "hull": "{raw.slate-400}" } } },
      "command":  { "$type": "color", "$extensions": { "orivellum.modes": { "daylight": "{raw.navy-700}", "hull": "{raw.gold-400}" } } }
    },
    "accent-ink": {
      "$description": "Label color on each app's solid accent. Daylight accents are dark, so ink is white everywhere; Hull accents are light, so each carries its own near-black tinted ink.",
      "writing":  { "$type": "color", "$extensions": { "orivellum.modes": { "daylight": "{raw.white}", "hull": "{raw.black-brass}" } } },
      "learning": { "$type": "color", "$extensions": { "orivellum.modes": { "daylight": "{raw.white}", "hull": "{raw.black-olive}" } } },
      "library":  { "$type": "color", "$extensions": { "orivellum.modes": { "daylight": "{raw.white}", "hull": "{raw.black-olive}" } } },
      "chat":     { "$type": "color", "$extensions": { "orivellum.modes": { "daylight": "{raw.white}", "hull": "{raw.black-teal}" } } },
      "studio":   { "$type": "color", "$extensions": { "orivellum.modes": { "daylight": "{raw.white}", "hull": "{raw.black-slate}" } } },
      "mail":     { "$type": "color", "$extensions": { "orivellum.modes": { "daylight": "{raw.white}", "hull": "{raw.black-slate}" } } },
      "command":  { "$type": "color", "$extensions": { "orivellum.modes": { "daylight": "{raw.white}", "hull": "{raw.black-brass}" } } }
    }
  },
  "$extensions": {
    "orivellum.contrastPairs": [
      { "fg": "semantic.text",        "bg": "semantic.canvas", "min": 7.0,  "modes": ["daylight", "hull"], "note": "body copy — AAA" },
      { "fg": "semantic.text",        "bg": "semantic.raised", "min": 7.0,  "modes": ["daylight", "hull"] },
      { "fg": "semantic.text-muted",  "bg": "semantic.canvas", "min": 4.5,  "modes": ["daylight", "hull"] },
      { "fg": "semantic.text-muted",  "bg": "semantic.raised", "min": 4.5,  "modes": ["daylight", "hull"] },
      { "fg": "semantic.text-subtle", "bg": "semantic.canvas", "min": 4.5,  "modes": ["daylight"], "note": "metadata floor in daylight; hull subtle is metadata-only, non-text-sized" },
      { "fg": "semantic.primary",     "bg": "semantic.canvas", "min": 4.5,  "modes": ["daylight", "hull"] },
      { "fg": "semantic.olive",       "bg": "semantic.canvas", "min": 4.5,  "modes": ["daylight", "hull"] },
      { "fg": "semantic.bronze",      "bg": "semantic.canvas", "min": 4.5,  "modes": ["daylight", "hull"] },
      { "fg": "semantic.sonar",       "bg": "semantic.canvas", "min": 4.5,  "modes": ["daylight", "hull"] },
      { "fg": "semantic.slate",       "bg": "semantic.canvas", "min": 4.5,  "modes": ["daylight", "hull"] },
      { "fg": "semantic.danger",      "bg": "semantic.canvas", "min": 4.5,  "modes": ["daylight", "hull"] },
      { "fg": "semantic.caution",     "bg": "semantic.canvas", "min": 4.5,  "modes": ["daylight", "hull"] },
      { "fg": "semantic.success",     "bg": "semantic.canvas", "min": 4.5,  "modes": ["daylight", "hull"] },
      { "fg": "semantic.info",        "bg": "semantic.canvas", "min": 4.5,  "modes": ["daylight", "hull"] },
      { "fg": "semantic.violet",      "bg": "semantic.canvas", "min": 4.5,  "modes": ["daylight", "hull"] },
      { "fg": "semantic.accent-ink",  "bg": "semantic.accent-default", "min": 4.5, "modes": ["daylight", "hull"], "note": "label on solid accent" },
      { "fg": "semantic.accent-ink",  "bg": "semantic.primary",        "min": 4.5, "modes": ["daylight", "hull"], "note": "label on primary action" },
      { "fg": "semantic.line-control","bg": "semantic.canvas", "min": 3.0,  "modes": ["daylight", "hull"], "note": "interactive boundary — WCAG 1.4.11" },
      { "fg": "semantic.line-control","bg": "semantic.raised", "min": 3.0,  "modes": ["daylight", "hull"] },
      { "fg": "semantic.focus",       "bg": "semantic.canvas", "min": 3.0,  "modes": ["daylight", "hull"], "note": "focus ring visibility" }
    ],
    "orivellum.componentAccentPairs": { "onCanvasMin": 4.5, "note": "every per-app accent must hold 4.5:1 on its mode's canvas" },
    "orivellum.chrome": {
      "daylight": { "themeColor": "{raw.bone-200}",     "statusBarStyle": "default" },
      "hull":     { "themeColor": "{raw.gunmetal-900}", "statusBarStyle": "black-translucent" }
    }
  }
}
