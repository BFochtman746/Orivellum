modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ps1-check"

[[workflows.workflow]]
name = "ps1-check"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run --with pytest pytest tests/test_powershell_scripts.py -q"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
MAIL_CLIENT_ID = "1eaaef36-5239-4332-8a99-4309dfe36182"
