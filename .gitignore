# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# SQLite runtime files
data/orivellum.db
data/orivellum.db-shm
data/orivellum.db-wal
data/*.db
data/*.db-shm

# Library file store (user-uploaded docs — not committed)
data/library/
# Generated audio from TTS
data/outputs/
data/*.mp3
data/*.wav

# Playwright test artifacts
test-results/
playwright-report/
e2e/.auth.json
e2e/report/
data/*.db-wal

# Temporary debug files uploaded during development
attached_assets/

# Generated API credentials — NEVER commit these files
# data/api_key.txt    — bearer token written by the API server on first startup
# data/.session_secret — session-signing secret written by the API server
data/api_key.txt
data/.session_secret
data/outputs/
data/nightshift/
data/backups/
data/remediation_archive/
PROGRESS.json

# Test DB sidecars
tmp*.db
tmp*.db-wal
tmp*.db-shm
tmp*/
