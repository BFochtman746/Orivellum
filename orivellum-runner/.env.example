# MOCK=1 runs the whole harness with deterministic analysis and no model.
# Every finding you see in mock mode came from a tool or the AST — which is
# exactly the point: the model explains, it does not detect.
MOCK=1

LLM_BASE_URL=http://127.0.0.1:13305/api/v1
LLM_MODEL=Qwen3.6-35B-A3B-GGUF
# Optional: use the coder model for per-function digests
LLM_CODER_MODEL=Qwen3-Coder-30B-A3B-Instruct-GGUF
LLM_TIMEOUT=300

# Hard stops. A run that cannot finish must stop and say so.
MAX_UNITS=4000
MAX_MINUTES=240
MAX_TOKENS=4000000
MAX_UNIT_RETRIES=2

# Cap context BELOW the model's real window on purpose — an agent that can see
# its own ceiling starts summarising early and abandoning work.
CTX_BUDGET_CHARS=24000
COMPACT_EVERY=25

USE_BANDIT=1
USE_SEMGREP=0
RUNS_DIR=runs
RUNNER_DB=runs/runner.db
